{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samsterkaudio",
  "compatibility_date": "2026-05-02",
  "main": "worker/src/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Without this, Cloudflare's edge tries to match/canonicalize static
    // asset requests *before* the Worker script ever runs, which silently
    // 307-redirects unmatched /pressing/* client routes (e.g. /pressing/library)
    // instead of letting index.ts's SPA fallback handle them.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pressing",
      "database_id": "789cac5b-b077-4b63-a01a-a8ec153617a6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "pressing-media"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "PROCESS_QUEUE", "queue": "pressing-process" }
    ],
    "consumers": [
      { "queue": "pressing-process" }
    ]
  },
  "vars": {
    "BETTER_AUTH_URL": "https://samsterkaudio.com",
    // RESEND_API_KEY is a secret (wrangler secret put RESEND_API_KEY), not
    // a var — without it, auth.ts falls back to logging magic links/codes.
    "RESEND_FROM": "Pressing <pressing@samsterkaudio.com>"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
